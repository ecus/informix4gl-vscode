{
	"name": "Informix 4GL",
	"scopeName": "source.4gl",
	"foldingStartMarker": "(^\\s*(FUNCTION|REPORT|MAIN|GLOBALS|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT)\\b)",
	"foldingStopMarker": "(^\\s*END\\s+(FUNCTION|REPORT|MAIN|GLOBALS|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT)\\b)",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#funcion-declaracion" },
		{ "include": "#sql-dml" },
		{ "include": "#control-flow" },
		{ "include": "#error-handling" },
		{ "include": "#screen-io" },
		{ "include": "#report-keywords" },
		{ "include": "#transactions" },
		{ "include": "#keywords" },
		{ "include": "#storage-types" },
		{ "include": "#builtin-functions" },
		{ "include": "#system-functions" },
		{ "include": "#aggregate-functions" },
		{ "include": "#builtin-variables" },
		{ "include": "#display-attributes" },
		{ "include": "#constants" },
		{ "include": "#operators" },
		{ "include": "#numbers" },
		{ "include": "#record-access" },
		{ "include": "#database-qualify" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-dash.4gl",
					"match": "--.*$"
				},
				{
					"name": "comment.line.number-sign.4gl",
					"match": "#.*$"
				},
				{
					"name": "comment.block.4gl",
					"begin": "\\{",
					"end": "\\}",
					"captures": {
						"0": { "name": "punctuation.definition.comment.4gl" }
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.4gl",
					"begin": "\"",
					"end": "\"",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.4gl" } },
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.4gl" } },
					"patterns": [
						{
							"name": "constant.character.escape.4gl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.single.4gl",
					"begin": "'",
					"end": "'",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.4gl" } },
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.4gl" } },
					"patterns": [
						{
							"name": "constant.character.escape.4gl",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"funcion-declaracion": {
			"patterns": [
				{
					"comment": "Function/Report declaration",
					"name": "meta.function.4gl",
					"match": "(?i)^\\s*(function|report)\\s+(\\w+)\\s*\\(([^)]*)\\)",
					"captures": {
						"1": { "name": "storage.type.function.4gl" },
						"2": { "name": "entity.name.function.4gl" },
						"3": { "name": "variable.parameter.4gl" }
					}
				},
				{
					"comment": "End function/report",
					"match": "(?i)^\\s*(end\\s+function|end\\s+report)\\b",
					"name": "storage.type.function.4gl"
				},
				{
					"comment": "MAIN block",
					"match": "(?i)^\\s*(main)\\s*$",
					"name": "storage.type.function.4gl"
				},
				{
					"comment": "END MAIN",
					"match": "(?i)^\\s*(end\\s+main)\\b",
					"name": "storage.type.function.4gl"
				},
				{
					"comment": "GLOBALS block",
					"match": "(?i)^\\s*(globals|end\\s+globals)\\b",
					"name": "storage.type.function.4gl"
				}
			]
		},
		"control-flow": {
			"patterns": [
				{
					"comment": "Control flow keywords",
					"match": "(?i)\\b(if|then|else|end\\s+if|while|end\\s+while|for|end\\s+for|foreach|end\\s+foreach|case|when|otherwise|end\\s+case|return|exit\\s+\\w+|exit|continue\\s+\\w+|continue|goto|label)\\b",
					"name": "keyword.control.4gl"
				}
			]
		},
		"error-handling": {
			"patterns": [
				{
					"comment": "WHENEVER error handling",
					"match": "(?i)\\b(whenever\\s+(any\\s+)?(error|sqlerror|sqlwarning|not\\s+found)\\s+(continue|stop|call|goto)\\b)",
					"name": "keyword.control.error.4gl"
				},
				{
					"comment": "DEFER INTERRUPT/QUIT",
					"match": "(?i)\\b(defer\\s+(interrupt|quit))\\b",
					"name": "keyword.control.error.4gl"
				}
			]
		},
		"sql-dml": {
			"patterns": [
				{
					"comment": "SQL DML keywords",
					"match": "(?i)\\b(select(\\s+distinct)?|insert\\s+into|into\\s+temp|update|delete\\s+from|delete|from|where|group\\s+by|order\\s+by|order\\s+external\\s+by|having|union(\\s+all)?|values|between|exists|matches|like|in)\\b",
					"name": "keyword.other.DML.4gl"
				},
				{
					"comment": "JOIN variants",
					"match": "(?i)\\b((inner|cross|left(\\s+outer)?|right(\\s+outer)?|outer|natural(\\s+(left|right)(\\s+outer)?)?)\\s+join|join)\\b",
					"name": "keyword.other.DML.4gl"
				},
				{
					"comment": "Sort order",
					"match": "(?i)\\b(asc|desc|ascending|descending)\\b",
					"name": "keyword.other.DML.4gl"
				},
				{
					"comment": "Cursor statements",
					"match": "(?i)\\b(declare|cursor|scroll\\s+cursor|with\\s+hold|open|fetch(\\s+(first|last|next|previous|prior|relative|absolute))?|close|free|prepare|execute(\\s+immediate)?|foreach|put|flush)\\b",
					"name": "keyword.other.DML.4gl"
				},
				{
					"comment": "DDL statements",
					"match": "(?i)\\b(create(\\s+temp)?\\s+(table|index|unique\\s+index)|drop\\s+(table|index)|alter\\s+table)\\b",
					"name": "keyword.other.DDL.4gl"
				},
				{
					"comment": "INTO keyword",
					"match": "(?i)\\b(into)\\b",
					"name": "keyword.other.DML.4gl"
				}
			]
		},
		"screen-io": {
			"patterns": [
				{
					"comment": "Screen I/O statements",
					"match": "(?i)\\b(display(\\s+array|\\s+by\\s+name|\\s+form)?|input(\\s+array|\\s+by\\s+name)?|end\\s+(input|display|construct)|construct(\\s+by\\s+name)?|message|error|prompt|sleep|scroll|clear(\\s+(form|screen|window))?)\\b",
					"name": "keyword.other.io.4gl"
				},
				{
					"comment": "Window/Form management",
					"match": "(?i)\\b(open\\s+(window|form)|close\\s+(window|form)|current\\s+window|display\\s+form|move\\s+window|hide\\s+window)\\b",
					"name": "keyword.other.io.4gl"
				},
				{
					"comment": "Menu statements",
					"match": "(?i)\\b(menu|command|end\\s+menu)\\b",
					"name": "keyword.other.io.4gl"
				},
				{
					"comment": "Field handling",
					"match": "(?i)\\b(field|infield|next\\s+field|before\\s+(field|input|construct|row|insert|delete|group)|after\\s+(field|input|construct|row|insert|delete|group)|before|after|on\\s+key|on\\s+every|on\\s+idle|without\\s+defaults|attribute|attributes|no\\s+wrap|formonly|noentry|required|autonext|screen\\s+record|show\\s+option|hide\\s+option|next\\s+option)\\b",
					"name": "keyword.other.io.4gl"
				}
			]
		},
		"report-keywords": {
			"patterns": [
				{
					"comment": "Report statements",
					"match": "(?i)\\b(start\\s+report|finish\\s+report|output(\\s+to(\\s+report)?)?|format|(first\\s+)?page\\s+header|page\\s+trailer|before\\s+group\\s+of|after\\s+group\\s+of|on\\s+every\\s+row|on\\s+last\\s+row|print|skip(\\s+to\\s+top\\s+of\\s+page)?|need|pause|column|page\\s+length|top\\s+of\\s+page|(top|bottom|left|right)\\s+margin)\\b",
					"name": "keyword.other.report.4gl"
				}
			]
		},
		"transactions": {
			"patterns": [
				{
					"comment": "Transaction control",
					"match": "(?i)\\b(begin\\s+work|commit\\s+work|rollback\\s+work|with\\s+no\\s+log)\\b",
					"name": "keyword.other.transaction.4gl"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"comment": "General keywords",
					"match": "(?i)\\b(database|define|let|call|returning|run|set|initialize|locate|validate|to|of|by\\s+name|using|clipped|spaces|wordwrap|through|thru|options|load|unload(\\s+to)?|lock\\s+(table|mode)|unlock\\s+table|set\\s+(isolation|lock\\s+mode|explain|optimization)|update\\s+statistics|grant|revoke|interrupt|lines|line|form|at|exit\\s+program|output\\s+to\\s+report)\\b",
					"name": "keyword.other.4gl"
				}
			]
		},
		"storage-types": {
			"patterns": [
				{
					"comment": "Data types",
					"match": "(?i)\\b(char(acter)?|varchar|nchar|nvarchar|string|integer|int|smallint|bigint|tinyint|serial|float|smallfloat|double(\\s+precision)?|real|decimal|dec|numeric|money|date|datetime|interval|byte|text|boolean|record|end\\s+record|array|like)\\b",
					"name": "storage.type.4gl"
				}
			]
		},
		"builtin-functions": {
			"patterns": [
				{
					"comment": "Built-in 4GL library functions",
					"match": "(?i)\\b(arg_val|arr_count|arr_curr|downshift|err_get|err_print|err_quit|errorlog|fgl_drawbox|fgl_getenv|fgl_getkey|fgl_keyval|fgl_lastkey|fgl_scr_size|fgl_setcurrline|fgl_dynarr_extentsize|fgl_isdynarr_allocated|field_touched|get_fldbuf|infield|length|num_args|ord|scr_line|set_count|showhelp|startlog|upshift|cursor_name|sqlexit|trim)(?=\\s*\\()",
					"name": "support.function.4gl"
				}
			]
		},
		"system-functions": {
			"patterns": [
				{
					"comment": "Date/Time and conversion functions",
					"match": "(?i)\\b(date|day|month|year|weekday|mdy|extend|ascii|decode|nvl|upper|lower)(?=\\s*\\()",
					"name": "support.function.4gl"
				}
			]
		},
		"aggregate-functions": {
			"patterns": [
				{
					"comment": "SQL aggregate functions",
					"match": "(?i)\\b(sum|count|avg|max|min)(?=\\s*\\()",
					"name": "support.function.aggregate.4gl"
				}
			]
		},
		"builtin-variables": {
			"patterns": [
				{
					"comment": "Built-in variables and constants",
					"match": "(?i)\\b(status|sqlca|sqlcode|sqlerrd|sqlawarn|int_flag|quit_flag|today|time|current|pageno|lineno)\\b",
					"name": "variable.language.4gl"
				}
			]
		},
		"display-attributes": {
			"patterns": [
				{
					"comment": "Display color and style attributes",
					"match": "(?i)\\b(black|blue|cyan|green|magenta|red|white|yellow|bold|dim|invisible|normal|reverse|underline|blink|border)\\b",
					"name": "support.constant.attribute.4gl"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"comment": "Language constants",
					"match": "(?i)\\b(null|true|false|notfound|dirty\\s+read)\\b",
					"name": "constant.language.4gl"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"comment": "Comparison and arithmetic operators",
					"match": "(==|!=|<>|<=|>=|<|>|=|\\+|-|\\*\\*|\\*|/|\\|\\|)",
					"name": "keyword.operator.4gl"
				},
				{
					"comment": "Logical and keyword operators",
					"match": "(?i)\\b(and|or|not|mod|is\\s+not\\s+null|is\\s+null|is|matches|between)\\b",
					"name": "keyword.operator.logical.4gl"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"comment": "Hexadecimal numbers",
					"match": "\\b0[xX][0-9a-fA-F]+\\b",
					"name": "constant.numeric.hex.4gl"
				},
				{
					"comment": "Decimal numbers",
					"match": "\\b[0-9]+(\\.[0-9]+)?\\b",
					"name": "constant.numeric.4gl"
				}
			]
		},
		"record-access": {
			"patterns": [
				{
					"comment": "Record field access (record.field)",
					"match": "\\b(\\w+)(\\.)(\\w+)\\b",
					"captures": {
						"1": { "name": "variable.other.record.4gl" },
						"2": { "name": "punctuation.accessor.4gl" },
						"3": { "name": "variable.other.field.4gl" }
					}
				}
			]
		},
		"database-qualify": {
			"patterns": [
				{
					"comment": "Database qualification (db:table)",
					"match": "(\\w+)(:)(\\w+)",
					"captures": {
						"1": { "name": "entity.name.database.4gl" },
						"2": { "name": "punctuation.separator.4gl" },
						"3": { "name": "entity.name.table.4gl" }
					}
				}
			]
		}
	}
}
