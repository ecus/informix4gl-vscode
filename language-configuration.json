{
    "comments": {
        "lineComment": "#",
        "blockComment": [ "{", "}" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "indentationRules": {
        "increaseIndentPattern": "(?i)^\\s*(MAIN|FUNCTION|REPORT|GLOBALS|IF|ELSE|WHILE|FOR|FOREACH|CASE|WHEN|OTHERWISE|MENU|COMMAND|INPUT|CONSTRUCT|FORMAT|PAGE\\s+HEADER|PAGE\\s+TRAILER|BEFORE\\s+GROUP|AFTER\\s+GROUP|ON\\s+EVERY|ON\\s+LAST|FIRST\\s+PAGE)\\b",
        "decreaseIndentPattern": "(?i)^\\s*(END\\s+(MAIN|FUNCTION|REPORT|GLOBALS|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT)|ELSE|OTHERWISE|WHEN|COMMAND|AFTER|BEFORE|ON)\\b"
    },
    "folding": {
        "markers": {
            "start": "(?i)^\\s*(FUNCTION|REPORT|MAIN|GLOBALS|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT)\\b",
            "end": "(?i)^\\s*END\\s+(FUNCTION|REPORT|MAIN|GLOBALS|IF|WHILE|FOR|FOREACH|CASE|MENU|INPUT|CONSTRUCT)\\b"
        }
    },
    "onEnterRules": [
        {
            "beforeText": "(?i)^\\s*(IF|ELSE|WHILE|FOR|FOREACH|CASE|WHEN|OTHERWISE|MAIN|FUNCTION|REPORT|GLOBALS|MENU|COMMAND|INPUT|CONSTRUCT)\\b.*$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "(?i)^\\s*END\\s+(IF|WHILE|FOR|FOREACH|CASE|MAIN|FUNCTION|REPORT|GLOBALS|MENU|INPUT|CONSTRUCT)\\b.*$",
            "action": { "indent": "outdent" }
        }
    ]
}
